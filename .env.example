# Copy to apps/api/.env.local for local dev. NEVER commit real values.
PORT=8080
NODE_ENV=development
# live | scripted | cached   (live needs GEMINI_API_KEY)
LLM_MODE=scripted
GEMINI_API_KEY=
MODEL_AGENT=gemini-4-hydrogen
MODEL_REASON=gemini-4-argon
MODEL_EMBED=gemini-embedding-2
MODEL_TESTER=gemini-4-hydrogen
# memory | firestore
STORE=memory
GOOGLE_CLOUD_PROJECT=ayden-buildathon
FIRESTORE_DATABASE=(default)
SESSION_SECRET=dev-only-change-me
# local-python is for local dev/tests ONLY. Never set in production.
SANDBOX=gemini
