{
  "name": "ayden",
  "version": "0.1.0",
  "private": true,
  "description": "Ayden: rehearse your first 90 days. AI workplace rehearsal platform.",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "npm -w @ayden/api run dev",
    "build": "npm run build:web && npm -w @ayden/api run build",
    "build:web": "node scripts/build-web.mjs",
    "start": "node apps/api/dist/server.js",
    "test": "npm -w @ayden/api run test",
    "typecheck": "npm -w @ayden/api run typecheck",
    "lint": "npm -w @ayden/api run lint",
    "smoke": "node scripts/smoke.mjs"
  }
}
